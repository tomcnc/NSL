SIMULATION_TYPE        0/1
DISTRIBUTION_TYPE      0/1  # (0 = Maxwell-Boltzmann, 1 = Dirac) use only if SIMULATION_TYPE = 0
RESTART                0/1
TEMP                   1.2
NPART                  108
RHO                    0.05
R_CUT                  5.0
DELTA                  0.001/2.5
NBLOCKS                20
NSTEPS                 2000
TAILS                  0/1 # 0 = tail corretions off 1 = tail corrections on NB: needs to be placed after R_CUT and NPART

ENDINPUT
